# Browser-public API base for gfireui-backend (no trailing slash).
PUBLIC_GFIREUI_API_BASE=http://127.0.0.1:8090

# Console identity (nav brand + jobs state rail header). Default: GFire
PUBLIC_GFIREUI_CONSOLE_TITLE=GFire

# SPA version shown in footer (usually matches VERSION file / image tag).
PUBLIC_GFIREUI_VERSION=0.1.1
